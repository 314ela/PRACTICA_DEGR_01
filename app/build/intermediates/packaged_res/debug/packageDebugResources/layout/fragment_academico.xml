<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- Encabezado IPN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/maroon_primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ipn_logo"
            android:scaleType="fitCenter"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ipn_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ipn_subtitle"
                android:textColor="@color/white"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_avatar"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/perfil_ipn"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Mi Progreso Academico -->
            <LinearLayout
                android:id="@+id/cardProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_gradient_progress"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mi_progreso_academico"
                            android:textColor="@color/white"
                            android:textSize="19sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/carrera_ejemplo"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/unidad_ejemplo"
                            android:textColor="#EDE0E8"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/porcentaje_ejemplo"
                            android:textColor="@color/white"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/semestre_6"
                            android:textColor="#EDE0E8"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_progress_track">

                    <View
                        android:layout_width="220dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_progress_fill"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/creditos_completados"
                        android:textColor="#EDE0E8"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activo"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Acceso Académico -->
            <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="@string/acceso_academico"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:columnCount="2"
                android:rowCount="2">

                <LinearLayout android:id="@+id/cardHistorial" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:layout_marginEnd="6dp" android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_gradient_blue" android:clickable="true" android:focusable="true"
                    android:orientation="vertical" android:padding="14dp">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_history" app:tint="@color/white"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                        android:text="@string/historial" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="@string/historial_academico" android:textColor="#E8E8E8" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardHorarioAcad" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:layout_marginStart="6dp" android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_gradient_orange" android:clickable="true" android:focusable="true"
                    android:orientation="vertical" android:padding="14dp">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_schedule" app:tint="@color/white"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                        android:text="@string/horario" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="@string/semestre_6" android:textColor="#E8E8E8" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardCredencialAcad" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_gradient_purple" android:clickable="true" android:focusable="true"
                    android:orientation="vertical" android:padding="14dp">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_badge" app:tint="@color/white"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                        android:text="@string/credencial_titulo" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="@string/escolar" android:textColor="#E8E8E8" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardNotifAcad" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:layout_marginStart="6dp"
                    android:background="@drawable/bg_gradient_red" android:clickable="true" android:focusable="true"
                    android:orientation="vertical" android:padding="14dp">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_notifications" app:tint="@color/white"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                        android:text="@string/notificaciones" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="@string/ver_historial" android:textColor="#E8E8E8" android:textSize="12sp"/>
                </LinearLayout>

            </GridLayout>

            <!-- Calendarios Escolares  -->
            <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="@string/calendarios_escolares"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginHorizontal="16dp"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/calEscolarizada"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circle_icon_light"
                        android:padding="8dp" android:src="@drawable/ic_event" app:tint="@color/maroon_primary"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/modalidad_escolarizada" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="@string/calendario_2025" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/calNoEscolarizada"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circle_icon_light"
                        android:padding="8dp" android:src="@drawable/ic_event" app:tint="@color/maroon_primary"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/modalidad_no_escolarizada" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:text="@string/calendario_2025" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
