<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!--  Encabezado IPN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/maroon_primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ipn_logo"
            android:scaleType="fitCenter"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ipn_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ipn_subtitle"
                android:textColor="@color/white"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_avatar"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/perfil_ipn"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingBottom="24dp">

            <!--  Trámites y Gestion-->
            <TextView style="@style/SectionTitle" android:text="@string/tramites_gestion"/>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_card_white" android:orientation="vertical">

                <LinearLayout android:id="@+id/rowCredencialEscolar" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_badge" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/credencial_escolar"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowBecas" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_attach_money" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/becas"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowRegistroExamen" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_assignment" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/registro_examen"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowReinscripcion" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_how_to_reg" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/reinscripcion"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Salud y Bienestar  -->
            <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="@string/salud_bienestar"/>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_card_white" android:orientation="vertical">

                <LinearLayout android:id="@+id/rowNss" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_local_hospital" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/registra_nss"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowImss" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_local_hospital" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/afiliacion_imss"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowPrevenimss" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_verified_user" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/cedula_prevenimss"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowSegurosVida" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_security" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/seguros_vida"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Beneficios Externos -->
            <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="@string/beneficios_externos"/>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_card_white" android:orientation="vertical">

                <LinearLayout android:id="@+id/rowAerolinea" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_flight" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/aerolinea_titulo"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Información General -->
            <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="@string/informacion_general"/>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_card_white" android:orientation="vertical">

                <LinearLayout android:id="@+id/rowCalendarioEscolar" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_event" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/calendario_escolar"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowBeneficios" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_sentiment_satisfied" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/beneficios"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowSendero" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_directions_bus" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/sendero_seguro"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Medios y Comunicacion -->
            <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="@string/medios_comunicacion"/>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_card_white" android:orientation="vertical">

                <LinearLayout android:id="@+id/rowRadioServ" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_radio" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/radio_ipn"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowCanalOnce" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tv" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/canal_once"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowGacetaServ" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_description" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/gaceta_politecnica_min"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowCarteleraServ" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_theaters" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/cartelera"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Seguridad  -->
            <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="@string/seguridad"/>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_card_white" android:orientation="vertical">

                <LinearLayout android:id="@+id/rowBotonPanico" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_pan_tool" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/boton_panico_completo"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowNumerosEmergencia" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_warning" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/numeros_emergencia"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
                <View style="@style/RowDivider"/>
                <LinearLayout android:id="@+id/rowDenunciaServ" style="@style/FilaSimple">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_report_problem" app:tint="@color/maroon_primary"/>
                    <TextView style="@style/FilaSimpleTexto" android:text="@string/denuncia_segura_titulo"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_hint"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
